# Copy this file to .env.local (or .env, matching your own workflow) and fill in real values.
#
# SECURITY: only the PUBLIC/PUBLISHABLE Supabase client key belongs in this app. NEVER put a
# Supabase service-role/secret key here, in any EXPO_PUBLIC_ variable, in app.json, or in any
# committed source file. The service-role key belongs only in a trusted server environment
# (Supabase's own dashboard/CLI, a future admin backend) — never in an Expo client bundle.
#
# Both values below are placeholders. The app treats these placeholder values as "Supabase
# not configured" (see src/lib/supabase.ts's isSupabaseConfigured) and continues running on
# existing local/prototype behavior until real values are provided.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Feature flag — Today stays on local prototype Daily data (current production behavior)
# unless this is the literal string "true" AND Supabase is configured (see
# isRemoteDailyEnabled in src/lib/supabase.ts). Leave "false" here; set it to "true" only in
# your own ignored .env.local for local testing against real Supabase Daily content.
EXPO_PUBLIC_REMOTE_DAILY_ENABLED=false

# RevenueCat PUBLIC iOS SDK key (Project settings -> API keys -> Apple App Store, in the
# RevenueCat dashboard) — NOT a secret; this exact key type is designed to ship inside the
# client binary, same trust model as the Supabase publishable key above. NEVER put a
# RevenueCat SECRET API key (used for their server-side REST API) here or anywhere in this
# app. The app treats a missing/placeholder value as "purchases not configured" (see
# isRevenueCatConfigured in src/services/purchases-service.ts) and premium always resolves to
# "free" (tester override, if enabled, still applies) until a real key is provided.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-public-ios-sdk-key-here
