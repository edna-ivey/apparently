# Copy this file to .env.local (or .env, matching your own workflow) and fill in real values.
#
# SECURITY: only the PUBLIC/PUBLISHABLE Supabase client key belongs in this app. NEVER put a
# Supabase service-role/secret key here, in any EXPO_PUBLIC_ variable, in app.json, or in any
# committed source file. The service-role key belongs only in a trusted server environment
# (Supabase's own dashboard/CLI, a future admin backend) — never in an Expo client bundle.
#
# Both values below are placeholders. The app treats these placeholder values as "Supabase
# not configured" (see src/lib/supabase.ts's isSupabaseConfigured) and continues running on
# existing local/prototype behavior until real values are provided.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
