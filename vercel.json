{
  "framework": null,
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.apparentlyyou.com" }],
      "destination": "https://apparentlyyou.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/quiz/:quizId", "destination": "/quiz/%5BquizId%5D" },
    { "source": "/s/:token", "destination": "/s/%5Btoken%5D" },
    { "source": "/privacy", "destination": "/privacy-policy" },
    { "source": "/terms", "destination": "/terms-of-use" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
