{
  "expo": {
    "name": "Apparently You",
    "slug": "apparently-you",
    "owner": "mekityus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "scheme": "apparently",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brand/app-icon.png",
      "bundleIdentifier": "com.supergreatventures.apparently",
      "buildNumber": "20",
      "associatedDomains": [
        "applinks:apparentlyyou.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Apparently You may use this to show you more relevant ads. You can continue without this — ads will still appear, just not personalized to you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@sentry/react-native",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Apparently You uses this to save your Creature image to your photo library when you tap Save."
        }
      ],
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "Apparently You may use this to show you more relevant ads. You can continue without this — ads will still appear, just not personalized to you.",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/app-icon.png",
          "color": "#17000F"
        }
      ],
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f1ed80a-7ccc-4b32-a580-71e6ed68bd07"
      }
    }
  }
}
